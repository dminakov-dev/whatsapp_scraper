# Copy to .env and adjust. .env is gitignored; this file is the documented template.

# --- Bridge (Phase 1: bridge_mock on 8001, Phase 2: real Node bridge on 8002 — swap by changing this URL only) ---
BRIDGE_URL=http://127.0.0.1:8001
# Shared secret: the real bridge requires it on every endpoint and sends it on webhooks
# (empty = disabled for local dev; set a long random value before linking WhatsApp)
BRIDGE_TOKEN=

# --- Collector ---
# Must be a loopback address (127.0.0.1, ::1, localhost). Anything else fails at startup unless
# ALLOW_NON_LOOPBACK=1, which additionally requires a non-empty BRIDGE_TOKEN.
HOST=127.0.0.1
ALLOW_NON_LOOPBACK=0
RECEIVER_PORT=8000
DB_PATH=data/collector.db
LOG_DIR=logs
LOG_LEVEL=INFO
# Person ids (@c.us / @lid) in logs and account_events of REJECTED payloads:
# masked = ********4567@c.us (default), full = as received. Text is never logged either way;
# stored messages and exports always keep full ids.
LOG_IDENTIFIERS=masked

# --- Pacing and backoff (seconds) ---
TICK_SLEEP=5
JITTER=2
BACKOFF_BASE=1
BACKOFF_MAX=300
# Sanity cap for a bridge Retry-After (honored in full up to this; capping is logged)
RETRY_AFTER_MAX=3600
REQUEST_TIMEOUT=10

# --- Batching ---
# 1..125: the stuck-cursor retry asks for 4x this, and the bridge accepts at most 500
BATCH_SIZE=50
# Seconds a caught-up chat rests before the next poll
TARGET_INTERVAL=60
# Re-sync targets from chat membership every N ticks
SYNC_EVERY=10
# History is re-read from cursor minus this many seconds, so messages delivered late
# (sent offline, stamped with their original time) are still collected; dedup absorbs repeats
BACKFILL_OVERLAP=600
# Message dates later than now + this many seconds are rejected (they would freeze the cursor)
FUTURE_TOLERANCE=300

# --- Mock bridge (Phase 1 only; ignored by the real bridge) ---
MOCK_HOST=127.0.0.1
MOCK_PORT=8001
MOCK_WEBHOOK_URL=http://127.0.0.1:8000/webhook
MOCK_SEED=42
# Messages kept per chat (history window) vs generated at startup (> window => older ones are gone)
MOCK_WINDOW=100
MOCK_HISTORY=150
# Seconds between live webhook events; 0 disables
MOCK_EMIT_INTERVAL=3
# Fault injection: probability per request / per event (0..1)
MOCK_FAIL_5XX=0.05
MOCK_FAIL_409=0.03
MOCK_FAIL_429=0.02
MOCK_RETRY_AFTER=10
MOCK_SLOW=0.02
MOCK_SLOW_SECONDS=15
MOCK_DUPLICATE=0.1
MOCK_MALFORMED=0.05
MOCK_AUTH_FAIL=0

# --- Real bridge (Phase 2, bridge/; read by `npm start` in bridge/) ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8002
WEBHOOK_URL=http://127.0.0.1:8000/webhook
WEBHOOK_ATTEMPTS=4
WEBHOOK_BACKOFF_MS=1000
# History window: first fetch is max(2*limit, MIN), doubled while it doesn't reach `since`, up to MAX
HISTORY_MIN_FETCH=50
HISTORY_MAX_FETCH=500
# Seconds between history calls; faster ones get 429 + Retry-After (quiet mode: e.g. 120)
HISTORY_MIN_INTERVAL=0
# WhatsApp Web operations slower than this answer 504; keep below REQUEST_TIMEOUT (ms)
OP_TIMEOUT_MS=8000
# 1 = tell WhatsApp the linked device is offline after it connects
PRESENCE_UNAVAILABLE=1
# Content-type allowlist. Empty CONTENT_TYPES = default (chat,image,video,audio,ptt,document,
# sticker,poll_creation). EXTRA_TYPES_BY_CHAT opens extra types for single groups/channels only:
# EXTRA_TYPES_BY_CHAT={"120363xxxxxxxxxxxx@g.us": ["location"]}
CONTENT_TYPES=
EXTRA_TYPES_BY_CHAT=
# Save raw responses as a fixture (private data, gitignored): e.g. fixtures/recorded
RECORD_DIR=
