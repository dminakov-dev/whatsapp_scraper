# Copy to .env and adjust. .env is gitignored; this file is the documented template.

# --- Bridge (Phase 1: bridge_mock, Phase 2: real Node bridge — swap by changing this URL only) ---
BRIDGE_URL=http://127.0.0.1:8001
# Shared secret the bridge must send in the X-Bridge-Token header (empty = disabled for local dev)
BRIDGE_TOKEN=

# --- Collector ---
HOST=127.0.0.1
RECEIVER_PORT=8000
DB_PATH=data/collector.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Pacing and backoff (seconds) ---
TICK_SLEEP=5
JITTER=2
BACKOFF_BASE=1
BACKOFF_MAX=300
REQUEST_TIMEOUT=10

# --- Batching ---
BATCH_SIZE=50
