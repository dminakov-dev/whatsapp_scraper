# Copy to .env and adjust. .env is gitignored; this file is the documented template.

# --- Bridge (Phase 1: bridge_mock, Phase 2: real Node bridge — swap by changing this URL only) ---
BRIDGE_URL=http://127.0.0.1:8001
# Shared secret the bridge must send in the X-Bridge-Token header (empty = disabled for local dev)
BRIDGE_TOKEN=

# --- Collector ---
HOST=127.0.0.1
RECEIVER_PORT=8000
DB_PATH=data/collector.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Pacing and backoff (seconds) ---
TICK_SLEEP=5
JITTER=2
BACKOFF_BASE=1
BACKOFF_MAX=300
REQUEST_TIMEOUT=10

# --- Batching ---
BATCH_SIZE=50
# Seconds a caught-up chat rests before the next poll
TARGET_INTERVAL=60
# Re-sync targets from chat membership every N ticks
SYNC_EVERY=10

# --- Mock bridge (Phase 1 only; ignored by the real bridge) ---
MOCK_HOST=127.0.0.1
MOCK_PORT=8001
MOCK_WEBHOOK_URL=http://127.0.0.1:8000/webhook
MOCK_SEED=42
# Messages kept per chat (history window) vs generated at startup (> window => older ones are gone)
MOCK_WINDOW=100
MOCK_HISTORY=150
# Seconds between live webhook events; 0 disables
MOCK_EMIT_INTERVAL=3
# Fault injection: probability per request / per event (0..1)
MOCK_FAIL_5XX=0.05
MOCK_FAIL_409=0.03
MOCK_FAIL_429=0.02
MOCK_RETRY_AFTER=10
MOCK_SLOW=0.02
MOCK_SLOW_SECONDS=15
MOCK_DUPLICATE=0.1
MOCK_MALFORMED=0.05
MOCK_AUTH_FAIL=0
